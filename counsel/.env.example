# 이 파일을 .env 로 복사해서 값을 채우세요. (배포 서비스에서는 '환경 변수' 화면에 같은 이름으로 넣으면 됩니다)

# 서비스 주소 (결제 후 돌아올 주소). 끝에 / 없이.
BASE_URL=http://localhost:3000
PORT=3000

# 관리자(상담사) 화면 비밀번호 — 길고 어렵게.
ADMIN_PASSWORD=change-me-please

# 결제 방식: mock(가짜 결제, 시험용) | toss(토스페이먼츠)
PAYMENT_MODE=mock
# 토스페이먼츠 결제위젯 키. 아래는 토스가 공개한 테스트 키입니다(실제 돈이 나가지 않음).
# 사업자 가입 후 개발자센터 → API 키에서 '결제위젯 연동 키'(live_gck_ / live_gsk_)로 바꾸세요.
TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6

# DB 파일 위치. 배포할 때는 지워지지 않는 디스크(볼륨) 경로로.
DB_PATH=./data/counsel.db

# (선택) 새 예약·메시지를 텔레그램으로 받기
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
